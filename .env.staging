# Staging Environment Configuration
VITE_NODE_ENV=staging

# Application Configuration
VITE_APP_NAME=ClaimsMotorX
VITE_APP_VERSION=1.0.0
VITE_APP_TITLE=CMX - Claims Management (Staging)

# Server Configuration (staging deployment)
VITE_HOST=0.0.0.0
VITE_PORT=80

# API Endpoints - Staging
VITE_API_BASE_URL=https://staging-api.claimsmotorx.com
VITE_GRAPHQL_URI=https://staging-api.claimsmotorx.com/graphql
VITE_GRAPHQL_WS_URI=wss://staging-api.claimsmotorx.com/graphql

# Backend Services URLs (staging)
VITE_CMX_BE_URL=https://staging-be.claimsmotorx.com
VITE_CMX_BFF_URL=https://staging-api.claimsmotorx.com
VITE_CMX_UPLOADER_URL=https://staging-upload.claimsmotorx.com

# File Upload Configuration
VITE_UPLOADER_PATH=/api/fnol/:fnolRef/images
VITE_UPLOADER_FIELD=file
VITE_MAX_FILE_SIZE=5242880
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# Feature Flags (staging - testing enabled)
VITE_ENABLE_DEVTOOLS=true
VITE_ENABLE_MOCK_DATA=false
VITE_ENABLE_DEBUG_LOGS=true
VITE_ENABLE_PERFORMANCE_MONITORING=true

# External Services (use staging API key)
VITE_GOOGLE_MAPS_API_KEY=${GOOGLE_MAPS_API_KEY_STAGING}

# Authentication (Staging)
VITE_AUTH_ENABLED=true
VITE_KEYCLOAK_URL=https://staging-auth.claimsmotorx.com
VITE_KEYCLOAK_REALM=claimsmotorx-staging
VITE_KEYCLOAK_CLIENT_ID=cmx-frontend-staging

# Cache and Performance
VITE_CACHE_ENABLED=true
VITE_CACHE_TTL=300000
VITE_GRAPHQL_CACHE_TTL=900000

# Monitoring and Analytics (staging)
VITE_SENTRY_DSN=${SENTRY_DSN_STAGING}
VITE_ANALYTICS_ENABLED=true
VITE_LOG_LEVEL=info