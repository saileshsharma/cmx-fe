
VITE_GOOGLE_MAPS_API_KEY=AIzaSyAptrLtZP-OTvngNcBZWW6xKRioh-vstz8

VITE_HOST=http://localhost
VITE_PORT=5173

# GraphQL HTTP endpoint (Vite proxy will forward to Spring Boot)

VITE_GRAPHQL_URI=http://127.0.0.1:8080/graphql

# Let apolloClient derive the WS URL from HTTP (→ ws://<host>/graphql)
# DO NOT set VITE_GRAPHQL_WS_URI unless your BE is truly exposing /graphql-ws
# VITE_GRAPHQL_WS_URI=

# Cookie credentials
VITE_GRAPHQL_CREDENTIALS=include

# point at your cmx-uploader
VITE_UPLOADER_URL=http://localhost:8081

# path that includes the fnol ref placeholder
VITE_UPLOADER_PATH=/api/fnol/:fnolRef/images

# field name expected by server
VITE_UPLOADER_FIELD=file

# optional: pass an auth header
# VITE_UPLOADER_AUTH_HEADER=Authorization
# VITE_UPLOADER_AUTH_VALUE=Bearer <token>
