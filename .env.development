# HTTP GraphQL endpoint
VITE_GRAPHQL_URI=http://localhost:8080/graphql

# WebSocket for subscriptions (choose the path your BE actually exposes)
# If your Spring GraphQL WS endpoint is /graphql:
VITE_GRAPHQL_WS_URI=ws://localhost:8080/graphql-ws


# If your endpoint is really /graphql-ws, then use:
# VITE_GRAPHQL_WS_URI=ws://localhost:8080/graphql-ws



# point at your cmx-uploader
VITE_UPLOADER_URL=http://localhost:8081

# path that includes the fnol ref placeholder
VITE_UPLOADER_PATH=/api/fnol/:fnolRef/images

# field name expected by server

VITE_UPLOADER_FIELD=file
# optional: pass an auth header
# VITE_UPLOADER_AUTH_HEADER=Authorization
# VITE_UPLOADER_AUTH_VALUE=Bearer <token>
