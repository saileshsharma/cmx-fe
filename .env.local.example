# Local Environment Overrides
# Copy this file to .env.local and update values as needed
# .env.local is gitignored and takes precedence over other environment files

# Override API endpoints for local development
# VITE_API_BASE_URL=http://192.168.1.100:4000
# VITE_GRAPHQL_URI=http://192.168.1.100:4000/graphql
# VITE_GRAPHQL_WS_URI=ws://192.168.1.100:4000/graphql

# Override feature flags for testing
# VITE_ENABLE_DEVTOOLS=true
# VITE_ENABLE_MOCK_DATA=true
# VITE_ENABLE_DEBUG_LOGS=true

# Override external service API keys (keep these secret!)
# VITE_GOOGLE_MAPS_API_KEY=your-local-dev-api-key

# Override authentication settings
# VITE_AUTH_ENABLED=false
# VITE_KEYCLOAK_URL=http://localhost:9091