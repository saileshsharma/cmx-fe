# Environment Variables Template
# Copy this file to .env.local and update values as needed
# .env.local takes precedence over environment-specific files

# Application Configuration
VITE_APP_NAME=ClaimsMotorX
VITE_APP_VERSION=1.0.0
VITE_APP_TITLE=CMX - Claims Management

# API Endpoints (update for your environment)
VITE_API_BASE_URL=http://localhost:4000
VITE_GRAPHQL_URI=http://localhost:4000/graphql
VITE_GRAPHQL_WS_URI=ws://localhost:4000/graphql

# Backend Services URLs
VITE_CMX_BE_URL=http://localhost:8080
VITE_CMX_BFF_URL=http://localhost:4000
VITE_CMX_UPLOADER_URL=http://localhost:8081

# File Upload Configuration
VITE_UPLOADER_PATH=/api/fnol/:fnolRef/images
VITE_UPLOADER_FIELD=file
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# Feature Flags
VITE_ENABLE_DEVTOOLS=true
VITE_ENABLE_MOCK_DATA=false
VITE_ENABLE_DEBUG_LOGS=true
VITE_ENABLE_PERFORMANCE_MONITORING=true

# External Services (replace with your own API keys)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Authentication
VITE_AUTH_ENABLED=false
VITE_KEYCLOAK_URL=http://localhost:9091
VITE_KEYCLOAK_REALM=auto-insurance
VITE_KEYCLOAK_CLIENT_ID=cmx-api

# Cache and Performance
VITE_CACHE_ENABLED=true
VITE_CACHE_TTL=300000
VITE_GRAPHQL_CACHE_TTL=600000

# Monitoring and Analytics
VITE_SENTRY_DSN=
VITE_ANALYTICS_ENABLED=false
VITE_LOG_LEVEL=debug