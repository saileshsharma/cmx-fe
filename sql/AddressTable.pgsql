{"cells":[{"value":"SELECT *\nFROM public.address\nLIMIT 2000;","kind":"sql","language":"sql"},{"value":"/*Update created_at as IS NOT NULL*/\r\n\r\nBEGIN;\r\n\r\n-- 1) Backfill any NULLs so NOT NULL won't fail\r\nUPDATE public.address\r\nSET created_at = NOW()\r\nWHERE created_at IS NULL;\r\n\r\n-- 2) Ensure a default for future inserts\r\nALTER TABLE public.address\r\n  ALTER COLUMN created_at SET DEFAULT NOW();\r\n\r\n-- (Optional) make sure it's timestamptz\r\n-- ALTER TABLE public.address\r\n--   ALTER COLUMN created_at TYPE timestamptz\r\n--   USING created_at::timestamptz;\r\n\r\n-- 3) Enforce NOT NULL\r\nALTER TABLE public.address\r\n  ALTER COLUMN created_at SET NOT NULL;\r\n\r\nCOMMIT;","kind":"sql","language":"sql"},{"value":"BEGIN;\r\n\r\n-- 1) Backfill existing NULLs and blanks\r\nUPDATE public.address\r\nSET\r\n  city          = COALESCE(NULLIF(city, ''), 'UNKNOWN'),\r\n  country       = COALESCE(NULLIF(country, ''), 'UNKNOWN'),\r\n  province      = COALESCE(NULLIF(province, ''), 'UNKNOWN'),\r\n  \"postalCode\"  = COALESCE(NULLIF(\"postalCode\", ''), '000000'),\r\n  \"addressLine1\"= COALESCE(NULLIF(\"addressLine1\", ''), '(unknown)');\r\n\r\n-- 2) Set sensible defaults for future inserts\r\nALTER TABLE public.address\r\n  ALTER COLUMN city           SET DEFAULT 'UNKNOWN',\r\n  ALTER COLUMN country        SET DEFAULT 'UNKNOWN',\r\n  ALTER COLUMN province       SET DEFAULT 'UNKNOWN',\r\n  ALTER COLUMN \"postal_code\"   SET DEFAULT '000000',\r\n  ALTER COLUMN \"addressLine1\" SET DEFAULT '(unknown)';\r\n\r\n-- 3) Enforce NOT NULL\r\nALTER TABLE public.address\r\n  ALTER COLUMN city            SET NOT NULL,\r\n  ALTER COLUMN country         SET NOT NULL,\r\n  ALTER COLUMN province        SET NOT NULL,\r\n  ALTER COLUMN \"postal_code\"    SET NOT NULL,\r\n  ALTER COLUMN \"addressLine1\"  SET NOT NULL;\r\n\r\n-- 4) (Optional but recommended) also prevent empty strings\r\nALTER TABLE public.address\r\n  ADD CONSTRAINT address_city_not_blank           CHECK (length(btrim(city)) > 0),\r\n  ADD CONSTRAINT address_country_not_blank        CHECK (length(btrim(country)) > 0),\r\n  ADD CONSTRAINT address_province_not_blank       CHECK (length(btrim(province)) > 0),\r\n  ADD CONSTRAINT address_postalcode_not_blank     CHECK (length(btrim(\"postal_code\")) > 0),\r\n  ADD CONSTRAINT address_addressline1_not_blank   CHECK (length(btrim(\"addressLine1\")) > 0);\r\n\r\nCOMMIT;","kind":"sql","language":"sql"},{"value":"ALTER TABLE public.address\r\n  DROP COLUMN IF EXISTS location;","kind":"sql","language":"sql"}],"metadata":{"connectionId":"1755479140424","databaseName":"cmx_new_db1","host":"localhost","port":5432,"username":"producer_user","password":"PRODUCER_USER","custom":{"cells":[{"value":"SELECT *\nFROM public.address\nLIMIT 2000;","kind":"sql","language":"sql"},{"value":"/*Update created_at as IS NOT NULL*/\r\n\r\nBEGIN;\r\n\r\n-- 1) Backfill any NULLs so NOT NULL won't fail\r\nUPDATE public.address\r\nSET created_at = NOW()\r\nWHERE created_at IS NULL;\r\n\r\n-- 2) Ensure a default for future inserts\r\nALTER TABLE public.address\r\n  ALTER COLUMN created_at SET DEFAULT NOW();\r\n\r\n-- (Optional) make sure it's timestamptz\r\n-- ALTER TABLE public.address\r\n--   ALTER COLUMN created_at TYPE timestamptz\r\n--   USING created_at::timestamptz;\r\n\r\n-- 3) Enforce NOT NULL\r\nALTER TABLE public.address\r\n  ALTER COLUMN created_at SET NOT NULL;\r\n\r\nCOMMIT;","kind":"sql","language":"sql"},{"value":"BEGIN;\r\n\r\n-- 1) Backfill existing NULLs and blanks\r\nUPDATE public.address\r\nSET\r\n  city          = COALESCE(NULLIF(city, ''), 'UNKNOWN'),\r\n  country       = COALESCE(NULLIF(country, ''), 'UNKNOWN'),\r\n  province      = COALESCE(NULLIF(province, ''), 'UNKNOWN'),\r\n  \"postalCode\"  = COALESCE(NULLIF(\"postalCode\", ''), '000000'),\r\n  \"addressLine1\"= COALESCE(NULLIF(\"addressLine1\", ''), '(unknown)');\r\n\r\n-- 2) Set sensible defaults for future inserts\r\nALTER TABLE public.address\r\n  ALTER COLUMN city      