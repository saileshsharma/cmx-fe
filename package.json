
{
  "name": "tailwind-react-vite-ui",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "build": "vite build",
    "build:prod": "NODE_ENV=production vite build",
    "preview": "vite preview",
    "preview:prod": "vite preview --host --port 4173",
    "serve:prod": "serve -s dist -l 3000",
    "start": "npm run dev",
    "start:prod": "npm run build:prod && npm run serve:prod",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --reporter=junit --outputFile=junit-report/junit.xml",
    "test:all": "npm run typecheck && npm run lint && npm run test && npm run e2e",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:debug": "playwright test --debug",
    "e2e:report": "playwright show-report",
    "quality": "npm run typecheck && npm run lint"
  },
  "dependencies": {
    "@apollo/client": "^3.14.0",
    "@react-google-maps/api": "^2.20.7",
    "@yudiel/react-qr-scanner": "^2.3.1",
    "chart.js": "^4.5.0",
    "graphql": "^16.11.0",
    "graphql-ws": "^6.0.6",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.7.1",
    "react-toastify": "^11.0.5",
    "react-window": "^1.8.11",
    "recharts": "^3.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.7.4",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^2.1.3",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.11.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.2",
    "happy-dom": "^15.7.4",
    "postcss": "^8.5.6",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite": "^4.4.5",
    "vitest": "^2.1.3",
    "@playwright/test": "^1.47.2",
    "wait-on": "^8.0.2",
    "serve": "^14.2.4"
  }
}
