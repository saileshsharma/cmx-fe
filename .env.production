# Production Environment Configuration
VITE_NODE_ENV=production

# Application Configuration
VITE_APP_NAME=ClaimsMotorX
VITE_APP_VERSION=1.0.0
VITE_APP_TITLE=CMX - Claims Management

# Server Configuration (production deployment)
VITE_HOST=0.0.0.0
VITE_PORT=80

# API Endpoints - Production (adjust these for your production deployment)
VITE_API_BASE_URL=https://api.claimsmotorx.com
VITE_GRAPHQL_URI=https://api.claimsmotorx.com/graphql
VITE_GRAPHQL_WS_URI=wss://api.claimsmotorx.com/graphql

# Backend Services URLs (production)
VITE_CMX_BE_URL=https://be.claimsmotorx.com
VITE_CMX_BFF_URL=https://api.claimsmotorx.com
VITE_CMX_UPLOADER_URL=https://upload.claimsmotorx.com

# File Upload Configuration
VITE_UPLOADER_PATH=/api/fnol/:fnolRef/images
VITE_UPLOADER_FIELD=file
VITE_MAX_FILE_SIZE=5242880
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# Feature Flags (production - strict settings)
VITE_ENABLE_DEVTOOLS=false
VITE_ENABLE_MOCK_DATA=false
VITE_ENABLE_DEBUG_LOGS=false
VITE_ENABLE_PERFORMANCE_MONITORING=true

# External Services (use production API key)
VITE_GOOGLE_MAPS_API_KEY=${GOOGLE_MAPS_API_KEY}

# Authentication (Production - secure)
VITE_AUTH_ENABLED=true
VITE_KEYCLOAK_URL=https://auth.claimsmotorx.com
VITE_KEYCLOAK_REALM=claimsmotorx
VITE_KEYCLOAK_CLIENT_ID=cmx-frontend

# Cache and Performance (optimized for production)
VITE_CACHE_ENABLED=true
VITE_CACHE_TTL=600000
VITE_GRAPHQL_CACHE_TTL=1800000

# Monitoring and Analytics (production)
VITE_SENTRY_DSN=${SENTRY_DSN}
VITE_ANALYTICS_ENABLED=true
VITE_LOG_LEVEL=error
